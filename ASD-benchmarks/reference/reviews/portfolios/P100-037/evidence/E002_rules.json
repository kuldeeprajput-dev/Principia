  "findings": [
    {
      "id": "P100-037-F1",
      "title": "Compact workload prediction remains weaker than the flexible baseline",
      "evidence": "The frozen load-dependent saturation equation has 4.0059 W mean run MAE, compared with 3.7315 W for the flexible workload model. It wins only one of five reserved runs.",
      "classification": "confirmed_comparison",
      "new_physical_law": false
    },
    {
      "id": "P100-037-F2",
      "title": "Separate component energy costs are not identified",
      "evidence": "Router A has a negative standalone throughput coefficient even though the total fitted response is increasing on the checked fixed-packet-size grid. The fitted terms cannot be interpreted as independent positive energy costs.",
      "classification": "identifiability_limit",
      "new_physical_law": false
    }
