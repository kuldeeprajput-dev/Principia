  "reference_model": "reference",
  "models": {
    "reference": {
      "equation": "Fhat=F5",
      "state": "rules.json",
      "role": "reference"
    },
    "baseline_persistence": {
      "equation": "Fhat=F5",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_linear": {
      "equation": "Fhat=F0+(F5-F0)*dose/dose_cal",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_langmuir": {
      "equation": "Fhat=F0+(F5-F0)*H(dose)/H(dose_cal); H(x)=x/(K+x)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_flexible": {
      "equation": "Frozen coefficient vector times exact features(case,kind,data) in run.py; fitted scale/ridge fully recorded.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001_hill": {
      "equation": "Fhat=F0+(F5-F0)*H(dose)/H(dose_cal); H(x)=x^n/(K^n+x^n)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002_quenching": {
      "equation": "Fhat=F0+(F5-F0)*H(x)/H(z)*exp(-q*(x-z)); H(x)=x/(K+x). Effective fluorescence loss, not binding occupancy.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003_local": {
      "equation": "Langmuir normalized at calibration dose; K inverted from F2/F5 baseline-subtracted ratio then multiplied by fitted factor",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004_dye_hill": {
      "equation": "Hill H with log K=b0+b1*dye_NR and common exponent n",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005_shrink_local": {
      "equation": "log K=w*log K_local+(1-w)*log K_shared",
      "state": "rules.json",
      "role": "comparator"
    }
  },
  "uncertainty_policy": {
    "method": "individual_group_effects_only",
    "reason": "Show every group and matched-baseline difference. Few groups/dates do not justify narrow population confidence intervals; no row bootstrap."
