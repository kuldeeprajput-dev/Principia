  "findings": [
    {
      "id": "P100-092-F1",
      "title": "A compact contrast correction improves the unchanged calibration map",
      "evidence": "The frozen six-coefficient correction has 3.6896 dB date-mean MAE versus 3.9234 dB for unchanged calibration: a 5.96% improvement on the three reserved dates. The full 3,120-cell initial map is a declared input, in addition to the six fitted coefficients.",
      "classification": "confirmed_scoped_comparison",
      "new_physical_law": false
    },
    {
      "id": "P100-092-F2",
      "title": "Compactness does not establish a stronger or uniquely physical rule",
      "evidence": "The flexible comparator reaches 3.6555 dB. The compact equation therefore misses its strongest-comparator admission requirement. Calibration split-half noise is small, but the measurements do not identify multipath, installation and receiver causes separately.",
      "classification": "negative_reference",
      "new_physical_law": false
    }
  ],
