  "models": {
    "spectral": {
      "equation": "VCD=max(0,b0+sum(bj*zj)); z standardizes [perm,deltaeps*fc_mhz^4,missing(perm),missing(deltaeps*fc_mhz^4)] with fixed development medians/means/scales.",
      "state": "rules.json",
      "role": "reference"
    },
    "linear_permittivity": {
      "equation": "VCD=max(0,b0+sum(bj*zj)); z uses perm and its missingness indicator, with fixed development imputation/scaling.",
      "state": "rules.json",
      "role": "comparator"
    },
    "availability_control": {
      "equation": "VCD=max(0,b0+sum(bj*zj)); z uses perm, finite(deltaeps_fc4) and their missingness indicators, with fixed development transforms.",
      "state": "rules.json",
      "role": "comparator"
    },
    "flexible": {
      "equation": "VCD=max(0,intercept+sum(dual_coefficient_j*exp(-gamma*||z-center_j||\u00b2))); z uses frozen causal features, medians, missingness and scaling; all centers and weights in model.json.",
      "state": "rules.json",
      "role": "comparator"
    }
  },
