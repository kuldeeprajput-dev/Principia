  "models": {
    "reference": {
      "equation": "F_hat=F6+d*(a*v6+b*6*c6)",
      "state": "rules.json",
      "role": "reference"
    },
    "baseline_persistence": {
      "equation": "F_hat(t)=F6",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_linear": {
      "equation": "F_hat=F6+v6*(t-6)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_mm": {
      "equation": "F_hat=V*S*t/(K+S)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_flexible": {
      "equation": "Frozen ridge polynomial: y_hat=phi(x)^T beta; exact dimensionless feature order/scales in run.features and coefficients in rules.json;85 nonnegative,87 clipped0..endowment",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001_saturation": {
      "equation": "F_hat=F6+v6*tau*(1-exp(-(t-6)/tau))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002_accelerating": {
      "equation": "F_hat=F6+v6*d+a*v6*(d-tau*(1-exp(-d/tau))),d=t-6",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003_power": {
      "equation": "F_hat=F6+a*v6*6*((1+d/6)^p-1)/p",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004_dose_saturation": {
      "equation": "F_hat=F6+v6*tau*(1-exp(-d/tau)),tau=exp(a+b*log(S));S is numerical concentration in uM",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005_curvature": {
      "equation": "F_hat=F6+v6*d+c6*tau*(d-tau*(1-exp(-d/tau)))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_006_slope_gate": {
      "equation": "F_hat=F6+d*(a*v6+b*6*c6)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_007_slope_only": {
      "equation": "F_hat=F6+a*d*v6",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_008_physical_saturation": {
      "equation": "F_hat=F6+v6*tau*(1-exp(-d/tau)),tau=exp(a+b*log(S)),b>=0",
      "state": "rules.json",
      "role": "comparator"
    }
  },
  "uncertainty_policy": {
