  "models": {
    "reference": {
      "equation": "yhat=baseline",
      "state": "rules.json",
      "role": "reference"
    },
    "baseline_persistence": {
      "equation": "yhat=baseline",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_decay": {
      "equation": "yhat=max(0,baseline+A*exp(-hours/tau))",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_flexible": {
      "equation": "Frozen coefficient vector times exact features(case,kind,data) in run.py; fitted scale/ridge fully recorded.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001_bateman": {
      "equation": "yhat=max(0,baseline+A*(exp(-hours/tau_decay)-exp(-hours/tau_rise)))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002_relative_decay": {
      "equation": "yhat=max(0,baseline*(1+A*exp(-hours/tau)))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003_two_decay": {
      "equation": "yhat=max(0,baseline+Afast*exp(-hours/tfast)+Aslow*exp(-hours/tslow))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004_baseline_drift": {
      "equation": "yhat=max(0,baseline+A*exp(-hours/tau)+b*baseline_change*exp(-hours/24))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005_lognormal": {
      "equation": "yhat=max(0,baseline+A*exp(-.5*(log(hours/tpeak)/sigma)^2))",
      "state": "rules.json",
      "role": "comparator"
    }
  },
