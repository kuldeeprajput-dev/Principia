  "models": {
    "reference": {
      "equation": "Ihat=I(.75)+max(A+B*I(.4)-I(.75),0)*(Ca-.75)/(K+Ca-.75); exact unit depletion coefficient.",
      "state": "rules.json",
      "role": "reference"
    },
    "baseline_persistence": {
      "equation": "Ihat=I(.75)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_hill4": {
      "equation": "Ihat=I(.75)*H(C)/H(.75); H(C)=C^4/(K^4+C^4)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_flexible": {
      "equation": "Frozen coefficient vector times exact features(case,kind,data) in run.py; fitted scale/ridge fully recorded.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001_genotype_hill": {
      "equation": "Ihat=I(.75)*H(C)/H(.75); H=C^n/(K_g^n+C^n); log K_g=b0+b1*mutant",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002_local_hill": {
      "equation": "n shared; invert K from ratio I(.4)/I(.75), then Hill extrapolation; clipped ill-conditioned inversions recorded",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003_two_pool": {
      "equation": "H=w*H4(C;K1)+(1-w)*H4(C;K2), scale fixed at.75mM",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004_reserve": {
      "equation": "Ihat=I(.75)+max(A0+Ag*mutant-lambda*I(.75),0)*(1-exp(-(Ca-.75)/K)); effective recruitable response reserve, not identified vesicle count.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005_reserve_pooled": {
      "equation": "Ihat=I(.75)+max(A-lambda*I(.75),0)*(1-exp(-(Ca-.75)/K)); common reserve across both genotypes.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_006_reserve_low04": {
      "equation": "Ihat=I(.75)+max(A+B*I(.4)-lambda*I(.75),0)*(1-exp(-(Ca-.75)/K)); test information from second calibration anchor.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_007_reserve_rational": {
      "equation": "Ihat=I(.75)+max(A+B*I(.4)-lambda*I(.75),0)*(Ca-.75)/(K+Ca-.75); rational rather than exponential reserve recruitment.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_008_reserve_conserved": {
      "equation": "Ihat=I(.75)+max(A+B*I(.4)-I(.75),0)*(Ca-.75)/(K+Ca-.75); exact unit depletion coefficient.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_009_reserve_genotype_rate": {
      "equation": "Ihat=I(.75)+max(A+B*I(.4)-I(.75),0)*(Ca-.75)/(K*exp(bg*mutant)+Ca-.75)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_010_reserve_no04": {
      "equation": "Ihat=I(.75)+max(A-I(.75),0)*(Ca-.75)/(K+Ca-.75); earlier calibration ablation.",
      "state": "rules.json",
      "role": "comparator"
    }
  },
