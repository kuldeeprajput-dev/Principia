    "baseline_tangent": {
      "equation": "p_hat(t+.2)=p(t)+2*(p(t)-p(t-.1))",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_flexible": {
      "equation": "Frozen coefficient vector times exact features(case,kind,data) in run.py; fitted scale/ridge fully recorded.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001_damped": {
      "equation": "p_hat=p0+a*(p0-p10)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002_periodic": {
      "equation": "p_hat=p0+a*(p0-p20)+b*(p0-2*p20+p40)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003_flow": {
      "equation": "p_hat=p0+a*(p0-p20)+b*(di0-de0)+c*(di0-di20)+d*(de0-de20)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004_regime": {
      "equation": "p_hat=p0+beta dot [v,acc,flow,v*I(flow>0),v*FEM,v*BH]",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005_limited": {
      "equation": "p_hat=p0+a*s*tanh((p0-p20)/s)",
