  "reference_model": "reference",
  "models": {
    "reference": {
      "equation": "Pnext=Ppast+a*memory+c*heterogeneity*Ppast",
      "state": "rules.json",
      "role": "reference"
    },
    "calibration": {
      "equation": "P_hat=p_initial",
      "state": "rules.json",
      "role": "comparator"
    },
    "constant": {
      "equation": "P_hat=a",
      "state": "rules.json",
      "role": "comparator"
    },
    "current": {
      "equation": "P_hat=p_now",
      "state": "rules.json",
      "role": "comparator"
    },
    "flexible": {
      "equation": "32center matched-prefix smooth predictor",
      "state": "rules.json",
      "role": "comparator"
    },
    "persistence": {
      "equation": "P_hat=p_past",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001": {
      "equation": "Pnext=Ppast+a*(Pnow-Ppast)+b*(Ppast-Pinitial)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002": {
      "equation": "Pnext=Ppast+bias+a*Ppast-b*Ppast\u00b3",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003": {
      "equation": "Pnext=Ppast+a*memory+b*drift+c*log1p(density)*memory+d*(speed/r90)*Ppast",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004": {
      "equation": "Pnext=Ppast+a*memory+b*drift+c*sqrt(within-personorder variance)*Ppast",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005": {
      "equation": "Pnext=Ppast+a*memory+c*heterogeneity*Ppast",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_006": {
      "equation": "Pnext=Ppast+a*memory+b*drift+c*heterogeneity",
      "state": "rules.json",
      "role": "comparator"
    }
  },
  "uncertainty_policy": {
