    "baseline_persistence": {
      "equation": "Nhat=N_last_prefix",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_rheobase": {
      "equation": "Nhat=max(0,g*(I-I0))",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_flexible": {
      "equation": "Frozen coefficient vector times exact features(case,kind,data) in run.py; fitted scale/ridge fully recorded.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001_condition_threshold": {
      "equation": "Nhat=max(0,g*(I-I0-bs*soft-bk*kd-bsk*soft*kd))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002_saturation": {
      "equation": "Nhat=N_last+A*(1-exp(-(I-10)/K))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003_recruitment": {
      "equation": "Nhat=max(0,(a+b*N_last+c*N_prefix_mean)*(I-10))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004_block": {
      "equation": "Nhat=N_last+g*(I-10)*exp(-max(I-Iblock,0)/K)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005_condition_gain": {
      "equation": "Nhat=N_last+max(0,a+bs*soft+bk*kd+bsk*soft*kd)*(I-10)^n",
      "state": "rules.json",
      "role": "comparator"
    }
  },
