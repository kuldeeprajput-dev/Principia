  "reference_model": "reference",
  "models": {
    "reference": {
      "equation": "c_hat(i,t)=c(i,t-1)",
      "state": "rules.json",
      "role": "reference"
    },
    "baseline_persistence": {
      "equation": "c_hat(i,t)=c(i,t-1)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_lag2_mean": {
      "equation": "c_hat=clip((c(t-1)+c(t-2))/2,0,e)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_half_endowment": {
      "equation": "c_hat=e/2",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_flexible": {
      "equation": "Frozen ridge polynomial: y_hat=phi(x)^T beta; exact dimensionless feature order/scales in run.features and coefficients in rules.json;85 nonnegative,87 clipped0..endowment",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001_focal": {
      "equation": "c_hat=clip(c_prev+a*(e/2-c_prev),0,e)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002_reciprocal": {
      "equation": "c_hat=clip(c_prev+a*(e*c_peer_prev/e_peer-c_prev),0,e)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003_coordination": {
      "equation": "c_hat=clip(c_prev+a*(required-c_prev),0,e)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004_success_gate": {
      "equation": "c_hat=clip(c_prev+a*(required-c_prev)*(1-success)+b*(e/2-c_prev)*(1-success)+c*(e/2-c_prev)*success,0,e)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005_history": {
      "equation": "c_hat=clip(c_prev+a*(own_history_mean-c_prev)+b*(required-c_prev)*(1-success),0,e)",
      "state": "rules.json",
      "role": "comparator"
    }
  },
  "uncertainty_policy": {
    "method": "individual_group_effects_only",
    "reason": "No row bootstrap; enumerate group errors and leave-group development variability. Single heldout condition is bounded evidence."
  },
