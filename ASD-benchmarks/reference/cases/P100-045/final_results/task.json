  "models": {
    "background": {
      "equation": "H_hat=B_H",
      "state": "rules.json",
      "role": "comparator"
    },
    "background_ratio": {
      "equation": "H_hat=B_H*L/B_L",
      "state": "rules.json",
      "role": "comparator"
    },
    "rbf": {
      "equation": "Frozen 24-center Gaussian radial-basis ridge comparator; all feature means, scales, centers, coefficients and ridge=0.3 are in rules.json. Additive residual for cases2/3/4/45; multiplicative clipped-log ratio for cases11/46.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001": {
      "equation": "H_hat=max(0,B_H+a*(L-B_L))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002": {
      "equation": "H_hat=max(0,B_H+1000*a*sign(z)*abs(z)^b); z=(L-B_L)/1000",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003": {
      "equation": "H_hat=B_H+a*max(L-B_L,0)/(1+max(L-B_L,0)/c)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004": {
      "equation": "H_hat=max(0,B_H+a*(L-B_L)+b*(L-L_previous))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005": {
      "equation": "H_hat=max(0,B_H+a*(L-B_L)*(E_low/100keV)^b)",
      "state": "rules.json",
      "role": "comparator"
    },
    "reference": {
      "equation": "H_hat=max(0,B_H+1000*a*sign(z)*abs(z)^b); z=(L-B_L)/1000",
      "state": "rules.json",
      "role": "reference"
    }
  },
