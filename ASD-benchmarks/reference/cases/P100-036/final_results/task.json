  "models": {
    "reference": {
      "equation": "sigmoid(b0+b1*r+b2*q+b3*NGRDI+b4*q*NGRDI+b5*tiny); r=Rfd/(1+abs(Rfd)), q=asinh(NPQ), size=ln(1+max(AREA_MM,0))/10",
      "state": "rules.json",
      "role": "reference"
    },
    "baseline_constant": {
      "equation": "sigmoid(b0); r=Rfd/(1+abs(Rfd)), q=asinh(NPQ), size=ln(1+max(AREA_MM,0))/10",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_context": {
      "equation": "sigmoid(b0+b1*tiny+b2*salt+b3*drought+b4*highstress); r=Rfd/(1+abs(Rfd)), q=asinh(NPQ), size=ln(1+max(AREA_MM,0))/10",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_flexible": {
      "equation": "sigmoid(b0+sum_j b_j exp(-mean((z-center_j)^2)/2)); training-only standardization; r=Rfd/(1+abs(Rfd)), q=asinh(NPQ), size=ln(1+max(AREA_MM,0))/10",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001_quenching": {
      "equation": "sigmoid(b0+b1/(1+max(NPQ,0))+b2*tiny); r=Rfd/(1+abs(Rfd)), q=asinh(NPQ), size=ln(1+max(AREA_MM,0))/10",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002_recovery": {
      "equation": "sigmoid(b0+b1*Rfd/(1+abs(Rfd))+b2*asinh(NPQ)+b3*tiny); r=Rfd/(1+abs(Rfd)), q=asinh(NPQ), size=ln(1+max(AREA_MM,0))/10",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003_pigment": {
      "equation": "sigmoid(b0+b1*r+b2*q+b3*NGRDI+b4*q*NGRDI+b5*tiny); r=Rfd/(1+abs(Rfd)), q=asinh(NPQ), size=ln(1+max(AREA_MM,0))/10",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004_morphology": {
      "equation": "sigmoid(b0+b1*r+b2*q+b3*NGRDI+b4*size+b5*size*q+b6*tiny); r=Rfd/(1+abs(Rfd)), q=asinh(NPQ), size=ln(1+max(AREA_MM,0))/10",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005_stress_regime": {
      "equation": "sigmoid(b0+b1*r+b2*q+b3*NGRDI+b4*tiny+b5*salt+b6*drought+b7*highstress+b8*q*salt+b9*q*drought); r=Rfd/(1+abs(Rfd)), q=asinh(NPQ), size=ln(1+max(AREA_MM,0))/10",
      "state": "rules.json",
      "role": "comparator"
    }
  },
