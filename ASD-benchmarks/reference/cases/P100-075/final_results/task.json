  "reference_model": "reference",
  "models": {
    "reference": {
      "equation": "y_hat=max(0,c+b1*s)",
      "state": "rules.json",
      "role": "reference"
    },
    "baseline_copy": {
      "equation": "y_hat=c",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_log_additive": {
      "equation": "y_hat=max(0,c+b1*ln(E/30)+b2*s)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_quadratic": {
      "equation": "y_hat=max(0,c+b1*x+b2*s+b3*x*s+b4*x^2+b5*x^2*s), x=ln(E/30)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001_saturation": {
      "equation": "y_hat=max(0,c+b1*q+b2*s), q=E/(K+E)-30/(K+30)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002_synergy": {
      "equation": "y_hat=max(0,c+b1*x+b2*s+b3*x*s), x=ln(E/30)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003_mechanical_only": {
      "equation": "y_hat=max(0,c+b1*ln(E/30))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004_threshold": {
      "equation": "y_hat=max(0,c+b1*I(E>=200)+b2*s+b3*s*I(E>=200))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005_shear_only": {
      "equation": "y_hat=max(0,c+b1*s)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_006_calibration_scaling": {
      "equation": "y_hat=max(0,c+b1*x+b2*s+b3*x*s+b4*(c-5)*s), x=ln(E/30)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_007_saturating_synergy": {
      "equation": "y_hat=max(0,c+b1*q+b2*s+b3*q*s), q=E/(K+E)-30/(K+30)",
      "state": "rules.json",
      "role": "comparator"
    }
  },
  "uncertainty_policy": {
