  "reference_model": "reference",
  "models": {
    "reference": {
      "equation": "Frozen coefficient vector times exact features(case,kind,data) in run.py; fitted scale/ridge fully recorded.",
      "state": "rules.json",
      "role": "reference"
    },
    "baseline_mean": {
      "equation": "p_hat=development group-weighted choice mean",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_utility": {
      "equation": "logit(p_hat)=b0+b1*(reward*probability/2-1)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_persistence": {
      "equation": "p_hat=clip(causal within-protocol previous-choice mean,.001,.999)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_flexible": {
      "equation": "Frozen coefficient vector times exact features(case,kind,data) in run.py; fitted scale/ridge fully recorded.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001_prospect": {
      "equation": "p_hat=sigmoid(beta*(w(p)*(reward/2)^alpha-1)+bias); w(p)=p^gamma/(p^gamma+(1-p)^gamma)^(1/gamma)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002_context": {
      "equation": "logit(p_hat)=beta dot [1,EVdiff,child,multi,description,child*multi,EVdiff*child,EVdiff*multi]",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003_memory": {
      "equation": "Context logits plus h,l,has_history*h, where h=history_mean-.5 and l=lag_choice-.5",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004_description": {
      "equation": "Memory logits plus (probability-.5)*description and its child interaction",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005_history_interaction": {
      "equation": "Context logits plus h,l,h*EVdiff,h*multi,h*child",
      "state": "rules.json",
      "role": "comparator"
    }
  },
  "uncertainty_policy": {
