  "confirmation_is_exposed": true,
  "applicability": "Seventy-six trajectories from configurations 1.1, 2.1 and 3.1. This predicts complete visible-interface transit, not a full trajectory. The observed transit target does not define the upstream speed; thus the comparison is not a restated identity. Interface bounds are supplied metadata whose availability must be declared in an application. Ambiguous thickness and fluid labels and absent normal-stress measurements limit mechanistic conclusions. Earlier interpolated-input analyses remain explicitly invalidated history.",
  "packaging_change": "Only navigation, code representation and packaging changed. No source measurement, fitted parameter, sample selection or admission decision changed.",
  "assigned_rows": 76,
  "packaged_rows": 76,
  "variable_semantics": {
    "orientation_cos2": "Mean cos(2*theta), dimensionless, range [-1,1]",
    "disk_or_rod_orientation_factor": "(1 + orientation_cos2)/2 = mean(cos(theta)^2)"
  }
