  "findings": [
    {
      "id": "P100-067-F1",
      "title": "The elementary upstream-speed transit predictor is the strongest of these reserved comparisons",
      "evidence": "The known transport approximation `T0 = h/v_up` has 0.11742 mean absolute log error, while the selected orientation correction has 0.36604. The ballistic approximation wins all three reserved fluid configurations. This is a scoped reproduction of an established approximation.",
      "classification": "baseline_reproduction",
      "new_physical_law": false
    },
    {
      "id": "P100-067-F2",
      "title": "The proposed individual-orientation mechanism does not survive the controls",
      "evidence": "The orientation correction loses to the original particle/family comparator and to a training-group mean-orientation control. Development shuffles and strict causal corrections also undermine the mechanism. No particle-thickness or normal-stress law is supported.",
      "classification": "negative_reference",
      "new_physical_law": false
    }
  ],
