      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_006": {
      "equation": "log1p(damage_hat)=robust(a+bL*loglength+bW*logwidth+bT*logduration)",
      "state": "rules.json",
      "role": "comparator"
    },
    "postfreeze_robust_domain": {
      "equation": "link(a+b*log_area); matched robust residual estimator",
      "state": "rules.json",
      "role": "comparator"
    },
    "postfreeze_robust_flexible": {
