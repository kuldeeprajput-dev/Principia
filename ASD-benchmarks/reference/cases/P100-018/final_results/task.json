    "reference": {
      "equation": "log1p(damage_hat)=robust geometry+context without duration",
      "state": "rules.json",
      "role": "reference"
    },
    "constant": {
      "equation": "constant on identity scale",
      "state": "rules.json",
      "role": "comparator"
    },
    "domain": {
      "equation": "link(a+b*log_area)",
      "state": "rules.json",
      "role": "comparator"
    },
    "flexible": {
      "equation": "32-center same-input radial-basis comparator",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001": {
      "equation": "log1p(damage_hat)=a+b*log1p(length_km)+c*log1p(width_m)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002": {
      "equation": "log1p(damage_hat)=a+bL*log1p(length)+bW*log1p(width_m)+bT*log1p(duration)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003": {
      "equation": "log1p(damage_hat)=geometry+duration+latitude+annual_harmonic",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004": {
      "equation": "log1p(damage_hat)=base003 with robust residual fitting",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005": {
