  "models": {
    "reference": {
      "equation": "j*(1-p-q+j)=exp(beta)*(p-j)*(q-j); y_hat=100*j, L=max(0,p+q-1), U=min(p,q)",
      "state": "rules.json",
      "role": "reference"
    },
    "baseline_independence": {
      "equation": "j=p*q; y_hat=100*j, L=max(0,p+q-1), U=min(p,q)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_constant": {
      "equation": "j=clip(b0,L,U); y_hat=100*j, L=max(0,p+q-1), U=min(p,q)",
      "state": "rules.json",
      "role": "comparator"
    },
    "baseline_flexible": {
      "equation": "j=clip(b0+b1*p+b2*q+b3*ln(dose),L,U); y_hat=100*j, L=max(0,p+q-1), U=min(p,q)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001_competence": {
      "equation": "j=p*q+alpha*(min(p,q)-p*q); y_hat=100*j, L=max(0,p+q-1), U=min(p,q)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002_odds_ratio": {
      "equation": "j*(1-p-q+j)=exp(beta)*(p-j)*(q-j); y_hat=100*j, L=max(0,p+q-1), U=min(p,q)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003_common_fraction": {
      "equation": "j=clip(p*q/tau,L,U); y_hat=100*j, L=max(0,p+q-1), U=min(p,q)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004_dose_competence": {
      "equation": "j=p*q+sigmoid(b0+b1*ln(dose))*(min(p,q)-p*q); y_hat=100*j, L=max(0,p+q-1), U=min(p,q)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005_competition": {
      "equation": "j=p*q+alpha*(p*q-L), -1<=alpha<=0; y_hat=100*j, L=max(0,p+q-1), U=min(p,q)",
      "state": "rules.json",
      "role": "comparator"
    }
