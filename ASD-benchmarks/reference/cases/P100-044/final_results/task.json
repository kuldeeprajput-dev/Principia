    },
    "rbf": {
      "equation": "t_hat=clip(7200*(intercept+sum_j w_j*exp(-||standardized_z-center_j||^2/(2*length^2))),0,7200); z=[ln(n),ln(d),I_flow,I_linear]",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001": {
      "equation": "t_hat=clip(exp(b0+b1*ln(n/(1+d^2))+b2*I_flow+b3*I_linear),0,7200)",
