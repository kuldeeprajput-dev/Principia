      "role": "comparator"
    },
    "attempt_005": {
      "equation": "duration=piecewise distance+routeoverhead+km*(cSin*sin(clock)+cCos*cos(clock))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_006": {
      "equation": "duration=robust005+weekend-specific inverse-speed slope",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_007": {
      "equation": "duration=robust piecewise distance +daily/weekend inverse-speed, nozoneoverheads",
