  "models": {
    "reference": {
      "equation": "duration=piecewise distance+routeoverhead+km*(cSin*sin(clock)+cCos*cos(clock))",
      "state": "rules.json",
      "role": "reference"
    },
    "constant": {
      "equation": "duration=a",
      "state": "rules.json",
      "role": "comparator"
    },
    "domain": {
      "equation": "duration=a+distance_km/v",
      "state": "rules.json",
      "role": "comparator"
    },
    "flexible": {
      "equation": "32-center matched-input smooth duration predictor",
      "state": "rules.json",
      "role": "comparator"
    },
    "robust_domain": {
      "equation": "duration=a+b*km; robust matched loss",
      "state": "rules.json",
      "role": "comparator"
    },
    "robust_flexible": {
      "equation": "32center same-input smooth predictor withrobust loss",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001": {
      "equation": "duration=a+b*km+c*peak+d*km*peak+e*weekend+f*km*weekend",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002": {
      "equation": "duration=a+b*km+cA*airport+dA*km*airport+cM*Manhattan+dM*km*Manhattan",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003": {
      "equation": "duration=robust route-specific overhead plusdistance inverse-speed",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004": {
      "equation": "duration=a+bS*min(km,3)+bL*max(km-3,0)+cA*airport+cM*Manhattan",
