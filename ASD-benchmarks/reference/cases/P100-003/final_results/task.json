    },
    "median4": {
      "equation": "R_hat=median(R1,R2,R3,R4)",
      "state": "rules.json",
      "role": "comparator"
    },
    "rbf": {
      "equation": "Frozen 24-center Gaussian radial-basis ridge comparator; all feature means, scales, centers, coefficients and ridge=0.3 are in rules.json. Additive residual for cases2/3/4/45; multiplicative clipped-log ratio for cases11/46.",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001": {
      "equation": "R_hat=max(0,m+a*(R1-m)); m=median4",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002": {
      "equation": "R_hat=max(0,m+a*(R1-m)+b*low1+c*high1)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003": {
      "equation": "R_hat=max(0,m+a*(R1-m)+b*line1)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004": {
      "equation": "R_hat=max(0,m+a*s*tanh((R1-m)/s)); s=max(MAD4,1e-9)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005": {
      "equation": "R_hat=max(0,m+a*(R1-m)/(1+abs(R1-R2)/s)+b*high1)",
      "state": "rules.json",
      "role": "comparator"
    },
    "reference": {
      "equation": "y_hat = training-fold median(target); final coefficient refit on development only",
      "state": "rules.json",
      "role": "reference"
    }
