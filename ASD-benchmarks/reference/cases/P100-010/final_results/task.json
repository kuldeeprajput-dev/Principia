    "reference": {
      "equation": "constant on logit scale",
      "state": "rules.json",
      "role": "reference"
    },
    "constant": {
      "equation": "constant on logit scale",
      "state": "rules.json",
      "role": "comparator"
    },
    "domain": {
      "equation": "link(a+b*log_age)",
      "state": "rules.json",
      "role": "comparator"
    },
    "flexible": {
      "equation": "32-center same-input radial-basis comparator",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_001": {
      "equation": "p=1-exp(-exp(a+b*log(1+age)+c*CNA_score))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_002": {
      "equation": "p=1-exp(-exp(a+b*log_age+c*CNA+d*log_batch+e*log_batch/(1+age)))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_003": {
      "equation": "p=logistic(a+b*log_age+c*CNA+d*CNA*log_age)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_004": {
      "equation": "p=1-exp(-exp(a+bY*min(log_age,log7)+bO*max(log_age-log7,0)+c*CNA))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_005": {
      "equation": "p=logistic(a+c*CNA_score)",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_006": {
      "equation": "p=logistic(a+b*log1p(source_day_batch))",
      "state": "rules.json",
      "role": "comparator"
    },
    "attempt_007": {
      "equation": "p=1-exp(-exp(a+c*CNA_score))",
      "state": "rules.json",
      "role": "comparator"
    }
  },
  "uncertainty_policy": {
