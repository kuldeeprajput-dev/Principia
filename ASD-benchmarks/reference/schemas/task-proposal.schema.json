{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "proposed_task_id",
    "target",
    "target_units",
    "permitted_inputs",
    "input_availability",
    "independent_groups",
    "baseline_families",
    "exclusions",
    "measurement_anchors",
    "evidence_assets",
    "exposure",
    "scientific_test",
    "source_derived_targets_disclosure"
  ],
  "properties": {
    "schema_version": {
      "const": "principia.task-proposal/3.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "proposed_task_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "target_units": {
      "type": "string",
      "minLength": 1
    },
    "permitted_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "independent_groups": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "baseline_families": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "measurement_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "locator"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "exposure": {
      "type": "object",
      "required": [
        "fresh_confirmation"
      ],
      "properties": {
        "fresh_confirmation": {
          "const": false
        }
      }
    }
  }
}
