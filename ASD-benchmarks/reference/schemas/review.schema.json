{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "role",
    "reviewer_id",
    "bindings",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "principia.review/3.0"
    },
    "role": {
      "enum": [
        "computational",
        "scientific_critical"
      ]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "minItems": 1
    }
  }
}
